{
  "name": "baby-tracker",
  "description": "A simple baby tracker app built with React Router and Prisma",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "typegen": "wrangler types",
    "test": "vitest",
    "test:watch": "vitest watch",
    "prisma:migrate": "dotenv -e .dev.vars -- npx prisma migrate dev",
    "prisma:generate": "dotenv -e .dev.vars -- npx prisma generate --no-engine",
    "prisma:studio": "dotenv -e .dev.vars -- npx prisma studio",
    "cloudflare:logs": "npx wrangler tail"
  },
  "cloudflare": {
    "label": "Remix Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/eb6781d2-a092-458b-772c-97b1cdaaf700/public",
    "dash": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.796.0",
    "@aws-sdk/s3-request-presigner": "^3.796.0",
    "@prisma/client": "^6.16.3",
    "@prisma/extension-accelerate": "^1.3.0",
    "@react-router/cloudflare": "^7.0.0",
    "@react-router/fs-routes": "^7.13.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "isbot": "5.1.25",
    "lucide-react": "^0.503.0",
    "react": "18.3.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "18.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250422.0",
    "@react-router/dev": "^7.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.29.0",
    "@typescript-eslint/parser": "8.29.0",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "9.23.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.3",
    "prisma": "^6.16.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.4",
    "typescript": "5.8.2",
    "vite": "^5.4.19",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.1.2",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
